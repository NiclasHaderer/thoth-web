use flake
# IntelliJ's SDK points at this link; the store path itself changes on every flake.lock bump.
ln -sfn "$JAVA_HOME" "$(direnv_layout_dir)/jdk"

watch_file web/.node-version
fnm install --log-level=quiet "$(cat web/.node-version)"
PATH_add "$(fnm exec --using=web/.node-version -- sh -c 'dirname "$(command -v node)"')"
